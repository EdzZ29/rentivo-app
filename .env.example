# Base URL of the Rentivo backend API (used by the Expo app).
#
# Leave this unset during local development: the app derives the API host from
# the Metro dev-server host, so a phone on the same Wi-Fi reaches your machine
# automatically, and the Android emulator falls back to 10.0.2.2.
#
# Set it explicitly for staging/production builds, or when the API is not on
# port 5000 of the dev machine:
# EXPO_PUBLIC_API_URL=https://api.rentivo.example/api
